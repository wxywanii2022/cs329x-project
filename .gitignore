__pycache__/
*.py[cod]
.venv/
.tools/
.cache/
*.egg-info/
build/
dist/
outputs/*
# RQ1 results are tracked; server logs, run locks and the v1 code snapshot
# (used only to resume v1 runs) stay local.
!outputs/rq1/
!outputs/rq1-v2/
!outputs/rq1-v3/
!outputs/rq1-v2-sc/
!outputs/rq1-main2/
outputs/rq1/code-snapshot/
# RQ2 pilot reports, transcripts, pooled analyses and review packets are tracked; raw run
# files (shards/, smoke/, fixtures-*/, traces) stay local and are shared out of band. The
# calibration key unblinds the review items, so it never enters Git.
!outputs/rq2-pilot*/
outputs/rq2-pilot*/*
!outputs/rq2-pilot*/report.md
!outputs/rq2-pilot*/report.json
!outputs/rq2-pilot*/transcripts/
!outputs/rq2-pilot*/pooled/
!outputs/rq2-pilot*/review/
outputs/rq2-pilot*/review/evaluator/key.private.csv
!outputs/rq2-coach-replay/
outputs/rq2-coach-replay/trace-coach.jsonl
!outputs/rq2-coach-nogap/
outputs/rq2-coach-nogap/trace-coach.jsonl
.run.lock
.env
.env.*
!.env.example
# Local model settings and human-reference/source records
/configs/*.local.json
/private/
# Main 2 model inputs are redacted but not guaranteed anonymous; copied to the cluster
# out of band and pinned by SHA-256 in outputs/rq1-main2/preregistration.json.
/data/rq1/main2/items.jsonl
# Main 2 run files embed conversation text (see /data/rq1/main2/items.jsonl); hashes in RAW_SHA256SUMS.
outputs/rq1-main2/*/main2-s*/frozen_inputs.json
outputs/rq1-main2/*/main2-s*/events.jsonl
outputs/rq1-main2/*/main2-s*/trace.jsonl
outputs/rq1-main2/*/main2-s*/predictions.jsonl
outputs/rq1-main2/*/main2-s*/labels.csv
